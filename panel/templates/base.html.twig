{% import '_icons.html.twig' as ui %}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{% block title %}{{ brand.name }}{% endblock %}</title>
    {# Inline data URI: no extra request, no 404, and it picks up the operator's
       accent so a white-labelled panel gets its own tab icon for free. #}
    <link rel="icon" href="data:image/svg+xml,{{ (
        '<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 32 32\'>'
        ~ '<rect width=\'32\' height=\'32\' rx=\'7\' fill=\'' ~ brand.accent ~ '\'/>'
        ~ '<text x=\'16\' y=\'22\' font-family=\'system-ui,sans-serif\' font-size=\'18\''
        ~ ' font-weight=\'700\' fill=\'white\' text-anchor=\'middle\'>'
        ~ brand.name|slice(0,1)|upper ~ '</text></svg>'
    )|url_encode }}">
    <style>
        /* Design tokens. Every colour resolves through these, so theming is an
           override of this block rather than a hunt through the stylesheet.
           The accent comes from the operator's branding config. */
        :root {
            --accent: {{ brand.accent }};
            --accent-contrast: #ffffff;
            --accent-soft: color-mix(in srgb, var(--accent) 10%, transparent);
            --bg: #eef2f6;
            --surface: #ffffff;
            --surface-sunken: #f8fafc;
            --border: #e3e8ef;
            --border-strong: #cbd5e1;
            --text: #1a2230;
            --text-muted: #64748b;
            --danger: #b91c1c;
            --danger-bg: #fef2f2;
            --danger-border: #fecaca;
            --success: #15803d;
            --success-bg: #f0fdf4;
            --warn: #a16207;
            --warn-bg: #fefce8;
            --radius: 6px;
            --radius-lg: 10px;
            --shadow: 0 1px 2px rgba(16,24,40,.05);
            --shadow-lift: 0 1px 3px rgba(16,24,40,.08), 0 6px 18px rgba(16,24,40,.06);
            --font: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
            --mono: ui-monospace, SFMono-Regular, Menlo, monospace;
            --sidebar: 14.5rem;
            --topbar: 3.25rem;
        }

        * { box-sizing: border-box; }
        body { margin:0; background:var(--bg); color:var(--text); font:14.5px/1.55 var(--font); }
        a { color:var(--accent); text-decoration:none; }
        a:hover { text-decoration:underline; }
        .icon { flex:none; vertical-align:-.2em; }

        /* --- frame ------------------------------------------------------- */
        .shell { display:grid; grid-template-columns:var(--sidebar) 1fr;
                 grid-template-rows:var(--topbar) 1fr; min-height:100vh; }

        .topbar { grid-column:1 / -1; display:flex; align-items:center; gap:1rem;
                  background:var(--surface); border-bottom:1px solid var(--border);
                  padding:0 1rem; position:sticky; top:0; z-index:10; }
        .topbar .brand { display:flex; align-items:center; gap:.5rem; font-weight:650;
                         font-size:1.02rem; letter-spacing:-.01em; width:calc(var(--sidebar) - 1rem);
                         color:var(--text); }
        .topbar .brand img { height:22px; width:auto; }
        .topbar .brand .mark { width:22px; height:22px; border-radius:5px; flex:none;
                               background:var(--accent); color:var(--accent-contrast);
                               display:grid; place-items:center; font-size:.72rem; font-weight:700; }
        .search { flex:1; max-width:26rem; position:relative; }
        .search input { width:100%; padding:.4rem .6rem .4rem 2rem; font-size:.88rem;
                        border:1px solid var(--border-strong); border-radius:var(--radius);
                        background:var(--surface-sunken); color:var(--text); font-family:inherit; }
        .search input:focus { outline:none; background:var(--surface); border-color:var(--accent);
                        box-shadow:0 0 0 3px var(--accent-soft); }
        .search .icon { position:absolute; left:.55rem; top:50%; transform:translateY(-50%);
                        color:var(--text-muted); pointer-events:none; }
        .whoami { margin-left:auto; display:flex; align-items:center; gap:.6rem;
                  font-size:.86rem; color:var(--text-muted); }
        .whoami .avatar { width:26px; height:26px; border-radius:50%; background:var(--accent-soft);
                          color:var(--accent); display:grid; place-items:center;
                          font-weight:700; font-size:.75rem; }
        .whoami strong { color:var(--text); font-weight:600; }

        aside { background:var(--surface); border-right:1px solid var(--border);
                padding:.85rem .6rem; }
        aside .group { font-size:.68rem; text-transform:uppercase; letter-spacing:.07em;
                       color:var(--text-muted); font-weight:700; padding:.7rem .65rem .3rem; }
        nav a { display:flex; align-items:center; gap:.6rem; padding:.48rem .65rem;
                border-radius:var(--radius); color:var(--text); font-size:.9rem; }
        nav a:hover { background:var(--surface-sunken); text-decoration:none; }
        nav a.active { background:var(--accent-soft); color:var(--accent); font-weight:600; }
        nav a.disabled { color:#9aa4b2; pointer-events:none; }
        nav a.disabled .soon { margin-left:auto; font-size:.62rem; text-transform:uppercase;
                               letter-spacing:.05em; color:#9aa4b2; }

        main { padding:1.5rem 1.75rem 3rem; min-width:0; }
        header.page { display:flex; align-items:flex-start; justify-content:space-between;
                      gap:1rem; margin:0 0 1.25rem; flex-wrap:wrap; }
        header.page h1 { font-size:1.3rem; margin:0; letter-spacing:-.02em; }
        header.page p { margin:.1rem 0 0; color:var(--text-muted); font-size:.88rem; }

        /* --- surfaces ---------------------------------------------------- */
        .card { background:var(--surface); border:1px solid var(--border);
                border-radius:var(--radius-lg); box-shadow:var(--shadow); margin:0 0 1rem; }
        .card > h2 { font-size:.92rem; margin:0; padding:.8rem 1.1rem; font-weight:600;
                     border-bottom:1px solid var(--border); }
        .card .body { padding:1.1rem; }

        .tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(10.5rem,1fr));
                 gap:.85rem; margin:0 0 1.25rem; }
        .tile { background:var(--surface); border:1px solid var(--border);
                border-radius:var(--radius-lg); padding:.95rem 1.1rem; box-shadow:var(--shadow); }
        .tile .label { color:var(--text-muted); font-size:.74rem; text-transform:uppercase;
                       letter-spacing:.06em; font-weight:700; }
        .tile .value { font-size:1.5rem; font-weight:650; letter-spacing:-.02em; margin-top:.1rem; }
        .tile .sub { color:var(--text-muted); font-size:.8rem; }

        /* --- domain list --------------------------------------------------
           Collapsed it reads as a table; expanded, each row reveals its tools.
           Built on <details> so it works with JavaScript disabled and stays
           keyboard operable for free. */
        .domain-list { background:var(--surface); border:1px solid var(--border);
                       border-radius:var(--radius-lg); box-shadow:var(--shadow);
                       overflow:hidden; }

        /* One grid template shared by the header and every row, so columns line
           up across cards the way a real table does. */
        .domain-cols { display:grid; align-items:center; gap:.75rem;
                       grid-template-columns:1.4rem minmax(0,2.4fr) minmax(0,1fr)
                                             6rem 6.5rem; padding:.6rem 1.1rem; }

        .domain-header { font-size:.72rem; text-transform:uppercase; letter-spacing:.06em;
                         color:var(--text-muted); font-weight:700;
                         border-bottom:1px solid var(--border); background:var(--surface-sunken); }

        .domain { border-bottom:1px solid var(--border); }
        .domain:last-child { border-bottom:0; }
        .domain > summary { cursor:pointer; list-style:none; }
        .domain > summary::-webkit-details-marker { display:none; }
        .domain > summary:hover { background:var(--surface-sunken); }
        .domain[open] > summary { background:var(--surface-sunken);
                                  border-bottom:1px solid var(--border); }
        .domain .chevron { color:var(--text-muted); transition:transform .15s ease; }
        .domain[open] .chevron { transform:rotate(90deg); }

        .domain-name { min-width:0; }
        .domain-name .n { font-weight:600; letter-spacing:-.01em; display:flex;
                          align-items:center; gap:.4rem; }
        .domain-name .path { font-family:var(--mono); font-size:.74rem; color:var(--text-muted);
                             overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
        .domain-cell { font-size:.84rem; color:var(--text-muted); overflow:hidden;
                       text-overflow:ellipsis; white-space:nowrap; }

        .tools { display:flex; flex-wrap:wrap; gap:.4rem; padding:.75rem 1.1rem;
                 background:var(--surface-sunken); }
        .tool { display:flex; flex-direction:column; align-items:center; justify-content:center;
                gap:.3rem; min-width:5.4rem; padding:.55rem .5rem; border-radius:var(--radius);
                background:var(--surface); border:1px solid var(--border);
                font-size:.74rem; color:var(--text); text-align:center; line-height:1.2; }
        .tool:hover { border-color:var(--accent); color:var(--accent); text-decoration:none; }
        .tool .icon { color:var(--text-muted); }
        .tool:hover .icon { color:var(--accent); }
        .tool.disabled { opacity:.5; pointer-events:none; }
        .tool.danger { color:var(--danger); border-color:var(--danger-border); }
        .tool.danger:hover { border-color:var(--danger); color:var(--danger); }
        .tool.disabled::after { content:"soon"; font-size:.6rem; text-transform:uppercase;
                                letter-spacing:.05em; color:var(--text-muted); }
        .tool form { margin:0; }
        .tool button { all:unset; cursor:pointer; display:flex; flex-direction:column;
                       align-items:center; gap:.3rem; }

        /* --- bits -------------------------------------------------------- */
        table { width:100%; border-collapse:collapse; }
        th { text-align:left; font-size:.72rem; text-transform:uppercase; letter-spacing:.06em;
             color:var(--text-muted); padding:.55rem 1.1rem; border-bottom:1px solid var(--border); }
        td { padding:.7rem 1.1rem; border-bottom:1px solid var(--border); font-size:.9rem; }
        tr:last-child td { border-bottom:0; }
        td.mono, .mono { font-family:var(--mono); font-size:.82rem; color:var(--text-muted); }

        .badge { display:inline-flex; align-items:center; gap:.25rem; padding:.08rem .45rem;
                 border-radius:999px; font-size:.72rem; font-weight:600; }
        .badge.ok    { background:var(--success-bg); color:var(--success); }
        .badge.warn  { background:var(--warn-bg);    color:var(--warn); }
        .badge.muted { background:var(--surface-sunken); color:var(--text-muted);
                       border:1px solid var(--border); }
        .dot { width:6px; height:6px; border-radius:50%; background:currentColor; }

        .btn { display:inline-flex; align-items:center; gap:.35rem; padding:.38rem .7rem;
               border-radius:var(--radius); background:var(--accent); color:var(--accent-contrast);
               border:1px solid transparent; font:inherit; font-size:.84rem; font-weight:600;
               cursor:pointer; }
        .btn:hover { filter:brightness(1.07); text-decoration:none; }
        .btn.ghost { background:var(--surface); color:var(--text); border-color:var(--border-strong); }
        .btn.ghost:hover { border-color:var(--accent); color:var(--accent); filter:none; }
        .btn.danger { background:var(--surface); color:var(--danger); border-color:var(--danger-border); }
        .btn.sm { padding:.25rem .5rem; font-size:.78rem; }

        /* A dropdown built on <details>: opens without JavaScript and closes
           on Escape or an outside click via the tiny handler below. */
        .menu { position:relative; display:inline-block; }
        .menu > summary { list-style:none; cursor:pointer; }
        .menu > summary::-webkit-details-marker { display:none; }
        .menu-items { position:absolute; right:0; top:calc(100% + .35rem); z-index:20;
                      min-width:11rem; padding:.3rem; background:var(--surface);
                      border:1px solid var(--border); border-radius:var(--radius);
                      box-shadow:var(--shadow-lift); }
        .menu-item { display:flex; align-items:center; gap:.5rem; width:100%;
                     padding:.45rem .55rem; border:0; border-radius:var(--radius);
                     background:transparent; color:var(--text); font:inherit;
                     font-size:.86rem; text-align:left; cursor:pointer; }
        .menu-item:hover { background:var(--surface-sunken); text-decoration:none; }
        .menu-item .icon { color:var(--text-muted); }

        label { display:block; font-size:.82rem; font-weight:500; margin:0 0 .3rem; }
        input, select { width:100%; padding:.45rem .6rem; margin:0 0 .9rem;
                        border-radius:var(--radius); border:1px solid var(--border-strong);
                        background:var(--surface); color:var(--text); font:inherit; font-size:.88rem; }
        input:focus, select:focus { outline:none; border-color:var(--accent);
                        box-shadow:0 0 0 3px var(--accent-soft); }
        .row { display:grid; grid-template-columns:repeat(auto-fit,minmax(11rem,1fr)); gap:0 1rem; }

        .flash { padding:.65rem .85rem; border-radius:var(--radius); margin:0 0 .9rem;
                 font-size:.88rem; border:1px solid; }
        .flash.ok    { background:var(--success-bg); border-color:#bbf7d0; color:var(--success); }
        .flash.error { background:var(--danger-bg);  border-color:var(--danger-border); color:var(--danger); }
        .flash ul { margin:.35rem 0 0; padding-left:1.1rem; }

        .empty { padding:2.25rem 1.1rem; text-align:center; color:var(--text-muted); }
        .empty p { margin:0 0 .9rem; }

        @media (max-width: 860px) {
            .shell { grid-template-columns:1fr; }
            aside { border-right:0; border-bottom:1px solid var(--border); }
            nav { display:flex; flex-wrap:wrap; }
            aside .group { display:none; }
            .topbar .brand { width:auto; }
            .search { display:none; }
            main { padding:1.1rem; }
            /* Drop to name and chevron only; the rest is in the expanded row. */
            .domain-cols { grid-template-columns:1.4rem 1fr; }
            .domain-cols > .hide-sm { display:none; }
        }
    </style>
</head>
<body>
<div class="shell">
    <div class="topbar">
        <span class="brand">
            {% if brand.logo_url %}
                <img src="{{ brand.logo_url }}" alt="{{ brand.name }}">
            {% else %}
                <span class="mark">{{ brand.name|slice(0,1)|upper }}</span>
            {% endif %}
            {{ brand.name }}
        </span>

        <div class="search">
            {{ ui.icon('search', 15) }}
            <input type="search" placeholder="Search domains and customers"
                   oninput="emberFilter(this.value)" aria-label="Search">
        </div>

        <div class="whoami">
            <span class="avatar">{{ app.user.userIdentifier|slice(0,1)|upper }}</span>
            <span><strong>{{ app.user.userIdentifier }}</strong><br>
                  {{ 'ROLE_ADMIN' in app.user.roles ? 'Administrator' : 'User' }}</span>
            <a class="btn ghost sm" href="/logout">Sign out</a>
        </div>
    </div>

    <aside>
        <nav>
            {% set route = app.request.attributes.get('_route') %}
            <a href="{{ path('dashboard') }}" class="{{ route == 'dashboard' ? 'active' }}">
                {{ ui.icon('grid') }} Dashboard
            </a>

            <div class="group">Hosting</div>
            <a href="{{ path('domains') }}" class="{{ route starts with 'domain' ? 'active' }}">
                {{ ui.icon('globe') }} Websites &amp; Domains
            </a>
            <a href="{{ path('customers') }}" class="{{ route starts with 'customer' ? 'active' }}">
                {{ ui.icon('users') }} Customers
            </a>
            {# Shown but disabled: the navigation states the intended shape of
               the product without pretending these pages exist. #}
            <a href="{{ path('databases') }}" class="{{ route starts with 'database' ? 'active' }}">
                {{ ui.icon('database') }} Databases
            </a>
            <a class="disabled">{{ ui.icon('mail') }} Mail <span class="soon">soon</span></a>
            <a class="disabled">{{ ui.icon('folder') }} Files <span class="soon">soon</span></a>

            <div class="group">Server</div>
            <a href="{{ path('system') }}" class="{{ route == 'system' ? 'active' }}">
                {{ ui.icon('server') }} System
            </a>
            <a class="disabled">{{ ui.icon('chart') }} Statistics <span class="soon">soon</span></a>
            <a href="{{ path('settings') }}" class="{{ route starts with 'settings' ? 'active' }}">
                {{ ui.icon('settings') }} Settings
            </a>
        </nav>
    </aside>

    <main>
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash {{ label }}">{{ message|raw }}</div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>
</div>

<script>
    // Close any open dropdown when clicking elsewhere or pressing Escape.
    // <details> does neither on its own, and a menu that stays open after use
    // feels broken.
    document.addEventListener('click', e => {
        document.querySelectorAll('details.menu[open]').forEach(menu => {
            if (!menu.contains(e.target)) menu.open = false;
        });
    });
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            document.querySelectorAll('details.menu[open]').forEach(m => m.open = false);
        }
    });

    // Client-side filter over anything marked data-filter. Deliberately not a
    // server round trip: at control-panel scale the whole list is already here.
    function emberFilter(term) {
        const needle = term.trim().toLowerCase();
        document.querySelectorAll('[data-filter]').forEach(el => {
            el.style.display = !needle || el.dataset.filter.includes(needle) ? '' : 'none';
        });
    }
</script>
</body>
</html>
