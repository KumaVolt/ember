<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{% block title %}{{ brand.name }}{% endblock %}</title>
    <style>
        /* Design tokens. Every colour resolves through these, so theming is an
           override of this block rather than a hunt through the stylesheet.
           The accent comes from the operator's branding config. */
        :root {
            --accent: {{ brand.accent }};
            --accent-contrast: #ffffff;
            --bg: #f1f5f9;
            --surface: #ffffff;
            --surface-sunken: #f8fafc;
            --border: #e2e8f0;
            --border-strong: #cbd5e1;
            --text: #0f172a;
            --text-muted: #64748b;
            --danger: #b91c1c;
            --danger-bg: #fef2f2;
            --danger-border: #fecaca;
            --success: #15803d;
            --success-bg: #f0fdf4;
            --warn: #a16207;
            --warn-bg: #fefce8;
            --radius: 8px;
            --radius-lg: 12px;
            --shadow: 0 1px 2px rgba(15,23,42,.06), 0 8px 24px rgba(15,23,42,.06);
            --font: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
            --mono: ui-monospace, SFMono-Regular, Menlo, monospace;
            --sidebar: 15rem;
        }

        * { box-sizing: border-box; }
        body { margin:0; background:var(--bg); color:var(--text); font:15px/1.6 var(--font); }
        a { color:var(--accent); }

        .shell { display:grid; grid-template-columns:var(--sidebar) 1fr; min-height:100vh; }

        aside { background:var(--surface); border-right:1px solid var(--border);
                padding:1.25rem 0; display:flex; flex-direction:column; }
        .brand { display:flex; align-items:center; gap:.55rem; padding:0 1.25rem 1.25rem;
                 font-weight:650; font-size:1.1rem; letter-spacing:-.02em; }
        .brand img { height:24px; width:auto; }
        nav { display:flex; flex-direction:column; gap:.1rem; padding:0 .6rem; }
        nav a { display:flex; align-items:center; gap:.6rem; padding:.5rem .65rem;
                border-radius:var(--radius); color:var(--text); text-decoration:none;
                font-size:.92rem; }
        nav a:hover { background:var(--surface-sunken); }
        nav a.active { background:color-mix(in srgb, var(--accent) 10%, transparent);
                       color:var(--accent); font-weight:600; }
        nav a svg { width:17px; height:17px; flex:none; }
        .nav-foot { margin-top:auto; padding:1rem 1.25rem 0; border-top:1px solid var(--border);
                    font-size:.82rem; color:var(--text-muted); }
        .nav-foot strong { color:var(--text); display:block; font-weight:600; }

        main { padding:1.75rem 2rem 3rem; min-width:0; }
        header.page { display:flex; align-items:flex-start; justify-content:space-between;
                      gap:1rem; margin:0 0 1.5rem; flex-wrap:wrap; }
        header.page h1 { font-size:1.35rem; margin:0; letter-spacing:-.02em; }
        header.page p { margin:.15rem 0 0; color:var(--text-muted); font-size:.9rem; }

        .card { background:var(--surface); border:1px solid var(--border);
                border-radius:var(--radius-lg); box-shadow:var(--shadow); margin:0 0 1rem; }
        .card > h2 { font-size:.95rem; margin:0; padding:.9rem 1.25rem;
                     border-bottom:1px solid var(--border); font-weight:600; }
        .card .body { padding:1.25rem; }

        .tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));
                 gap:1rem; margin:0 0 1.5rem; }
        .tile { background:var(--surface); border:1px solid var(--border);
                border-radius:var(--radius-lg); padding:1.1rem 1.25rem; box-shadow:var(--shadow); }
        .tile .label { color:var(--text-muted); font-size:.78rem; text-transform:uppercase;
                       letter-spacing:.06em; font-weight:600; }
        .tile .value { font-size:1.6rem; font-weight:650; letter-spacing:-.02em; margin-top:.15rem; }
        .tile .sub { color:var(--text-muted); font-size:.82rem; }

        table { width:100%; border-collapse:collapse; }
        th { text-align:left; font-size:.75rem; text-transform:uppercase; letter-spacing:.06em;
             color:var(--text-muted); padding:.6rem 1.25rem; border-bottom:1px solid var(--border); }
        td { padding:.75rem 1.25rem; border-bottom:1px solid var(--border); font-size:.92rem;
             vertical-align:middle; }
        tr:last-child td { border-bottom:0; }
        td.mono, .mono { font-family:var(--mono); font-size:.85rem; color:var(--text-muted); }

        .badge { display:inline-block; padding:.1rem .5rem; border-radius:999px;
                 font-size:.75rem; font-weight:600; }
        .badge.ok    { background:var(--success-bg); color:var(--success); }
        .badge.warn  { background:var(--warn-bg);    color:var(--warn); }
        .badge.muted { background:var(--surface-sunken); color:var(--text-muted); }

        .btn { display:inline-block; padding:.45rem .85rem; border-radius:var(--radius);
               background:var(--accent); color:var(--accent-contrast); border:0;
               font:inherit; font-size:.88rem; font-weight:600; cursor:pointer;
               text-decoration:none; }
        .btn:hover { filter:brightness(1.08); }
        .btn.ghost { background:transparent; color:var(--text); border:1px solid var(--border-strong); }
        .btn.danger { background:transparent; color:var(--danger);
                      border:1px solid var(--danger-border); }

        label { display:block; font-size:.85rem; font-weight:500; margin:0 0 .35rem; }
        input, select { width:100%; padding:.5rem .65rem; margin:0 0 1rem;
                        border-radius:var(--radius); border:1px solid var(--border-strong);
                        background:var(--surface); color:var(--text); font:inherit;
                        font-size:.92rem; }
        input:focus, select:focus { outline:none; border-color:var(--accent);
                        box-shadow:0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent); }
        .row { display:grid; grid-template-columns:repeat(auto-fit,minmax(12rem,1fr)); gap:0 1rem; }

        .flash { padding:.7rem .9rem; border-radius:var(--radius); margin:0 0 1rem;
                 font-size:.9rem; border:1px solid; }
        .flash.ok    { background:var(--success-bg); border-color:#bbf7d0; color:var(--success); }
        .flash.error { background:var(--danger-bg);  border-color:var(--danger-border); color:var(--danger); }
        .flash ul { margin:.4rem 0 0; padding-left:1.1rem; }

        .empty { padding:2.5rem 1.25rem; text-align:center; color:var(--text-muted); }
        .empty p { margin:0 0 1rem; }

        @media (max-width: 800px) {
            .shell { grid-template-columns:1fr; }
            aside { border-right:0; border-bottom:1px solid var(--border); }
            nav { flex-direction:row; overflow-x:auto; }
            .nav-foot { display:none; }
            main { padding:1.25rem; }
        }
    </style>
</head>
<body>
<div class="shell">
    <aside>
        <div class="brand">
            {% if brand.logo_url %}<img src="{{ brand.logo_url }}" alt="{{ brand.name }}">{% endif %}
            {{ brand.name }}
        </div>
        <nav>
            {% set nav = [
                { route: 'dashboard', label: 'Dashboard' },
                { route: 'domains',   label: 'Websites & Domains' },
                { route: 'customers', label: 'Customers' },
                { route: 'system',    label: 'System' }
            ] %}
            {% for item in nav %}
                <a href="{{ path(item.route) }}"
                   class="{{ app.request.attributes.get('_route') == item.route ? 'active' : '' }}">
                    {{ item.label }}
                </a>
            {% endfor %}
        </nav>
        <div class="nav-foot">
            <strong>{{ app.user.userIdentifier }}</strong>
            {{ 'ROLE_ADMIN' in app.user.roles ? 'Administrator' : 'User' }}
            <div style="margin-top:.5rem"><a href="/logout">Sign out</a></div>
        </div>
    </aside>

    <main>
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash {{ label }}">{{ message|raw }}</div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>
</div>
</body>
</html>
