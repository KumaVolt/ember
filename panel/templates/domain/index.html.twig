{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}
{% block title %}{{ brand.name }} — Websites &amp; Domains{% endblock %}

{% block body %}
    <header class="page">
        <div>
            <h1>Websites &amp; Domains</h1>
            <p>Each domain has its own directory, logs and pool, owned by its customer.</p>
        </div>
        <a class="btn" href="{{ path('domain_new') }}">{{ ui.icon('plus', 15) }} Add domain</a>
    </header>

    {% if domains is empty %}
        <div class="card">
            <div class="empty">
                <p>No domains yet.</p>
                <a class="btn" href="{{ path('domain_new') }}">{{ ui.icon('plus', 15) }} Add your first domain</a>
            </div>
        </div>
    {% else %}
        <div class="domain-list">
            <div class="domain-cols domain-header">
                <span></span>
                <span>Domain</span>
                <span class="hide-sm">Customer</span>
                <span class="hide-sm">Server</span>
                <span class="hide-sm">TLS</span>
            </div>

            {% for domain in domains %}
                {% set cert = domain.certificate|default(null) %}
                {# <details> keeps this working without JavaScript and makes the
                   row keyboard-operable. The summary holds no interactive
                   children, so expanding never fights with a click target. #}
                <details class="domain" data-filter="{{ (domain.name ~ ' ' ~ domain.customer_username)|lower }}">
                    <summary class="domain-cols">
                        <span class="chevron">{{ ui.icon('chevron', 15) }}</span>

                        <span class="domain-name">
                            <span class="n">{{ domain.name }}
                                <span class="badge ok"><span class="dot"></span>{{ domain.status }}</span>
                            </span>
                            <span class="path">{{ domain.docroot }}</span>
                        </span>

                        <span class="domain-cell hide-sm">{{ domain.customer_username }}</span>
                        <span class="domain-cell hide-sm">{{ domain.webserver }}</span>
                        <span class="hide-sm">
                            {% if cert and cert.present %}
                                <span class="badge {{ cert.renews_soon ? 'warn' : 'ok' }}">
                                    {{ ui.icon('lock', 11) }}
                                    {{ cert.days_remaining is not null ? cert.days_remaining ~ 'd' : 'on' }}
                                </span>
                            {% else %}
                                <span class="badge muted">none</span>
                            {% endif %}
                        </span>
                    </summary>

                    <div class="tools">
                        <a class="tool" href="http{{ cert and cert.present ? 's' }}://{{ domain.name }}"
                           target="_blank" rel="noopener">{{ ui.icon('external', 17) }} Open</a>

                        {% if not (cert and cert.present) %}
                            <form method="post" class="tool"
                                  action="{{ path('domain_certificate', {id: domain.id}) }}"
                                  title="Request a Let's Encrypt certificate">
                                <button type="submit">{{ ui.icon('lock', 17) }} SSL/TLS</button>
                            </form>
                        {% else %}
                            <span class="tool" title="Certificate active; renewal is automatic">
                                {{ ui.icon('shield', 17) }} SSL/TLS
                            </span>
                        {% endif %}

                        <span class="tool disabled">{{ ui.icon('folder', 17) }} Files</span>
                        <span class="tool disabled">{{ ui.icon('database', 17) }} Databases</span>
                        <span class="tool disabled">{{ ui.icon('code', 17) }} PHP</span>
                        <span class="tool disabled">{{ ui.icon('file-text', 17) }} Logs</span>
                        <span class="tool disabled">{{ ui.icon('mail', 17) }} Mail</span>
                        <span class="tool disabled">{{ ui.icon('settings', 17) }} Hosting</span>

                        <form method="post" class="tool danger"
                              action="{{ path('domain_delete', {id: domain.id}) }}"
                              onsubmit="return confirm('Remove {{ domain.name }} and delete its files?')">
                            <button type="submit">{{ ui.icon('trash', 17) }} Remove</button>
                        </form>
                    </div>
                </details>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
