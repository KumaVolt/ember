{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}
{% block title %}{{ brand.name }} — Websites &amp; Domains{% endblock %}

{% block body %}
    <header class="page">
        <div>
            <h1>Websites &amp; Domains</h1>
            <p>Each domain has its own directory, logs and pool, owned by its customer.</p>
        </div>
        {% if customers is not empty %}
            <button class="btn" onclick="document.getElementById('add-domain').hidden = false; this.hidden = true;">
                {{ ui.icon('plus', 15) }} Add domain
            </button>
        {% endif %}
    </header>

    <div class="card" id="add-domain" {{ domains is not empty and customers is not empty ? 'hidden' : '' }}>
        <h2>Add a domain</h2>
        <div class="body">
            {% if customers is empty %}
                <p style="margin:0;color:var(--text-muted)">
                    Add a <a href="{{ path('customers') }}">customer</a> first — every domain belongs
                    to one, and its files are owned by that customer's system account.
                </p>
            {% else %}
                <form method="post" action="{{ path('domain_new') }}">
                    <div class="row">
                        <div>
                            <label for="name">Domain name</label>
                            <input id="name" name="name" placeholder="example.com"
                                   autocapitalize="none" spellcheck="false" required>
                        </div>
                        <div>
                            <label for="customer_id">Customer</label>
                            <select id="customer_id" name="customer_id" required>
                                {% for customer in customers %}
                                    <option value="{{ customer.id }}">
                                        {{ customer.display_name ?: customer.username }} ({{ customer.username }})
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div>
                            <label for="webserver">Web server</label>
                            <select id="webserver" name="webserver">
                                <option value="nginx">nginx</option>
                                <option value="apache">apache</option>
                            </select>
                        </div>
                    </div>
                    <button class="btn" type="submit">Create domain</button>
                </form>
            {% endif %}
        </div>
    </div>

    {% if domains is empty %}
        <div class="card"><div class="empty"><p>No domains yet.</p></div></div>
    {% endif %}

    {% for domain in domains %}
        {% set cert = domain.certificate|default(null) %}
        <div class="domain" data-filter="{{ (domain.name ~ ' ' ~ domain.customer_username)|lower }}">
            <div class="domain-head">
                <span class="globe">{{ ui.icon('globe', 19) }}</span>

                <div class="domain-title">
                    <div class="name">
                        <a href="http{{ cert and cert.present ? 's' }}://{{ domain.name }}"
                           target="_blank" rel="noopener">{{ domain.name }}</a>
                        {{ ui.icon('external', 13) }}
                        <span class="badge ok"><span class="dot"></span>{{ domain.status }}</span>
                        {% if cert and cert.present %}
                            <span class="badge {{ cert.renews_soon ? 'warn' : 'ok' }}">
                                {{ ui.icon('lock', 11) }}
                                {{ cert.days_remaining is not null ? cert.days_remaining ~ 'd' : 'TLS' }}
                            </span>
                        {% else %}
                            <span class="badge muted">no TLS</span>
                        {% endif %}
                    </div>
                    <div class="domain-meta">
                        <span class="path">{{ domain.docroot }}</span>
                        <span class="sep">·</span>
                        <span>{{ domain.customer_username }}</span>
                        <span class="sep">·</span>
                        <span>{{ domain.webserver }}</span>
                        {% if domain.php_version %}
                            <span class="sep">·</span><span>PHP {{ domain.php_version }}</span>
                        {% endif %}
                    </div>
                </div>

                <div class="domain-actions">
                    <form method="post" action="{{ path('domain_delete', {id: domain.id}) }}"
                          onsubmit="return confirm('Remove {{ domain.name }} and delete its files?')">
                        <button class="btn danger sm" type="submit">{{ ui.icon('trash', 13) }} Remove</button>
                    </form>
                </div>
            </div>

            {# The tool strip. Only the ones that actually do something are
               live; the rest are visibly unavailable rather than dead links. #}
            <div class="tools">
                {% if not (cert and cert.present) %}
                    <form method="post" action="{{ path('domain_certificate', {id: domain.id}) }}"
                          class="tool" title="Request a Let's Encrypt certificate">
                        <button type="submit">{{ ui.icon('lock', 17) }} SSL/TLS</button>
                    </form>
                {% else %}
                    <span class="tool" title="Certificate active; renewal is automatic">
                        {{ ui.icon('shield', 17) }} SSL/TLS
                    </span>
                {% endif %}
                <span class="tool disabled">{{ ui.icon('folder', 17) }} Files</span>
                <span class="tool disabled">{{ ui.icon('database', 17) }} Databases</span>
                <span class="tool disabled">{{ ui.icon('code', 17) }} PHP</span>
                <span class="tool disabled">{{ ui.icon('file-text', 17) }} Logs</span>
                <span class="tool disabled">{{ ui.icon('mail', 17) }} Mail</span>
                <span class="tool disabled">{{ ui.icon('settings', 17) }} Hosting</span>
            </div>
        </div>
    {% endfor %}
{% endblock %}
