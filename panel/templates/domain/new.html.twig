{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}
{% block title %}{{ brand.name }} — Add a domain{% endblock %}

{% block body %}
    <header class="page">
        <div>
            <h1>Add a domain</h1>
            <p>Its files are created under <code class="mono">/var/www/vhosts/</code> and owned
               by the customer's system account.</p>
        </div>
        <a class="btn ghost" href="{{ path('domains') }}">Cancel</a>
    </header>

    <div class="card" style="max-width:38rem">
        <div class="body">
                <form method="post" action="{{ path('domain_create') }}">
                    <label for="name">Domain name</label>
                    <input id="name" name="name" placeholder="example.com" value="{{ submitted.name|default('') }}"
                           autocapitalize="none" spellcheck="false" required autofocus>

                    <div class="row">
                        <div>
                            <label for="customer_id">Customer</label>
                            <select id="customer_id" name="customer_id" required
                                    onchange="document.getElementById('new-customer').hidden = this.value !== '__new__';
                                              document.getElementById('new_customer_username').required = this.value === '__new__';">
                                {# The signed-in account's own customer comes first and is
                                   selected: most domains added here are their own. #}
                                {% for customer in customers %}
                                    <option value="{{ customer.id }}"
                                            {{ customer.username == app.user.userIdentifier ? 'selected' }}>
                                        {{ customer.display_name ?: customer.username }} ({{ customer.username }})
                                        {{ customer.username == app.user.userIdentifier ? ' — you' }}
                                    </option>
                                {% endfor %}
                                <option value="__new__"
                                            {{ customers is empty or submitted.customer_id|default('') == '__new__' ? 'selected' }}>
                                    + New customer…
                                </option>
                            </select>
                        </div>
                        <div>
                            <label for="webserver">Web server</label>
                            <select id="webserver" name="webserver">
                                <option value="nginx">nginx</option>
                                <option value="apache">apache</option>
                            </select>
                        </div>
                    </div>

                    {# Revealed by the select above, and shown from the start when
                       there is no customer to pick. #}
                    <div id="new-customer"
                         {{ customers is empty or submitted.customer_id|default('') == '__new__' ? '' : 'hidden' }}
                         style="border:1px solid var(--border);border-radius:var(--radius);
                                padding:1rem;margin:0 0 1rem;background:var(--surface-sunken)">
                        <div style="font-weight:600;font-size:.88rem;margin-bottom:.6rem">
                            New customer
                        </div>
                        <div class="row">
                            <div>
                                <label for="new_customer_username">Username</label>
                                <input id="new_customer_username" name="new_customer_username"
                                       value="{{ submitted.new_customer_username|default('') }}"
                                       placeholder="acme" autocapitalize="none" spellcheck="false"
                                       {{ customers is empty ? 'required' }}>
                            </div>
                            <div>
                                <label for="new_customer_display_name">Display name</label>
                                <input id="new_customer_display_name" name="new_customer_display_name"
                                       value="{{ submitted.new_customer_display_name|default('') }}"
                                       placeholder="Acme Ltd">
                            </div>
                            <div>
                                <label for="new_customer_email">Email</label>
                                <input id="new_customer_email" name="new_customer_email"
                                       value="{{ submitted.new_customer_email|default('') }}"
                                       type="email" placeholder="ops@acme.com">
                            </div>
                        </div>
                        <p style="color:var(--text-muted);font-size:.76rem;margin:-.5rem 0 0">
                            This creates a system account. The domain's files will be owned by it,
                            which is what keeps one customer out of another's.
                        </p>
                    </div>

                    {% if server.available|default(false) %}
                        <div style="border-top:1px solid var(--border);padding-top:1rem;margin-top:.4rem">
                            <label style="display:flex;gap:.5rem;align-items:flex-start;font-weight:400">
                                <input type="checkbox" name="with_database" value="1" checked
                                       style="width:auto;margin:.25rem 0 0"
                                       onchange="document.getElementById('dbname-row').hidden = !this.checked">
                                <span>
                                    Create a database for this site
                                    <br><span style="color:var(--text-muted);font-size:.78rem">
                                        A database and a user that can reach only it. The password is
                                        shown once after creation.
                                    </span>
                                </span>
                            </label>

                            <div id="dbname-row" style="margin-top:.7rem;max-width:18rem">
                                <label for="database_name">Database name
                                    <span style="color:var(--text-muted);font-weight:400">— optional</span>
                                </label>
                                <input id="database_name" name="database_name"
                                       value="{{ submitted.database_name|default('') }}"
                                       placeholder="taken from the domain name"
                                       autocapitalize="none" spellcheck="false">
                                <p style="color:var(--text-muted);font-size:.76rem;margin:-.7rem 0 0">
                                    Prefixed with the customer's name, so it becomes
                                    <code class="mono">customer_name</code>.
                                </p>
                            </div>
                        </div>
                    {% else %}
                        <p style="color:var(--text-muted);font-size:.8rem;margin:0 0 1rem">
                            No database server is available, so no database will be created. Install
                            MariaDB from <a href="{{ path('settings_services') }}">Settings → Services</a>.
                        </p>
                    {% endif %}

                    <button class="btn" type="submit" style="margin-top:1rem">
                        {{ ui.icon('plus', 15) }} Create domain
                    </button>
                </form>
        </div>
    </div>
{% endblock %}
