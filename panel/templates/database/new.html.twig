{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}
{% block title %}{{ brand.name }} — Add a database{% endblock %}

{% block body %}
    <header class="page">
        <div>
            <h1>Add a database</h1>
            <p>A database, and a user that can reach it and nothing else.</p>
        </div>
        <a class="btn ghost" href="{{ path('databases') }}">Cancel</a>
    </header>

    <div class="card" style="max-width:38rem">
        <div class="body">
            {% if customers is empty %}
                <p style="margin:0;color:var(--text-muted)">
                    Add a <a href="{{ path('customer_new') }}">customer</a> first — a database
                    belongs to one.
                </p>
            {% else %}
                <form method="post" action="{{ path('database_create') }}">
                    <label for="name">Database name</label>
                    <input id="name" name="name" placeholder="wordpress" autocapitalize="none"
                           spellcheck="false" required autofocus>
                    <p style="color:var(--text-muted);font-size:.78rem;margin:-.7rem 0 .9rem">
                        Lowercase letters, digits and <code class="mono">_</code>. The customer's
                        name is prefixed automatically, so <code class="mono">wordpress</code>
                        becomes <code class="mono">acme_wordpress</code> — two customers can both
                        use the same name.
                    </p>

                    <div class="row">
                        <div>
                            <label for="customer_id">Customer</label>
                            <select id="customer_id" name="customer_id" required>
                                {% for customer in customers %}
                                    <option value="{{ customer.id }}">
                                        {{ customer.display_name ?: customer.username }} ({{ customer.username }})
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div>
                            <label for="engine">Engine</label>
                            <select id="engine" name="engine">
                                {% for e in engines|default([]) %}
                                    <option value="{{ e.engine }}" {{ not e.available ? 'disabled' }}>
                                        {{ e.engine == 'mariadb' ? 'MariaDB' : 'PostgreSQL' }}{{ not e.available ? ' — not running' }}
                                    </option>
                                {% else %}
                                    <option value="mariadb">MariaDB</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <button class="btn" type="submit">{{ ui.icon('plus', 15) }} Create database</button>
                    <p style="color:var(--text-muted);font-size:.8rem;margin:.9rem 0 0">
                        A password is generated and shown once. It is not stored, so copy it
                        before leaving the page.
                    </p>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
