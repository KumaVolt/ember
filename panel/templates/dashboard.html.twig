{% extends 'base.html.twig' %}
{% block title %}Ember — Dashboard{% endblock %}

{% block body %}
    <div class="card">
        <h2>Identity</h2>
        <dl>
            <dt>User</dt><dd>{{ app.user.userIdentifier }}</dd>
            <dt>Roles</dt><dd>{{ app.user.roles|join(', ') }}</dd>
            <dt>Authenticated by</dt><dd>{{ auth_type }}</dd>
            <dt>Firewall</dt><dd>remote_user (Symfony built-in)</dd>
        </dl>
    </div>

    <div class="card">
        <h2>Service</h2>
        {% if status %}
            <dl>
                <dt>Status</dt>
                <dd><span class="badge ok">{{ status.status }}</span></dd>
                <dt>Mode</dt>
                <dd>
                    <span class="badge {{ status.manages_this_machine ? 'warn' : 'ok' }}">
                        {{ status.mode }}
                    </span>
                </dd>
                <dt>Listening on</dt><dd>{{ status.host }}:{{ status.port }}</dd>
                <dt>Engine</dt><dd>{{ status.engine.name }} {{ status.engine.version }}</dd>
                <dt>Engine pool</dt><dd>{{ status.engine.pool }}</dd>
                <dt>Uptime</dt><dd>{{ status.uptime_seconds }}s</dd>
            </dl>
        {% else %}
            <p style="margin:0;color:#8b90a0">Ember's control API did not respond.</p>
        {% endif %}
    </div>

    <div class="card">
        <h2>Stack</h2>
        <dl>
            <dt>Symfony</dt><dd>{{ symfony_version }}</dd>
            <dt>PHP</dt><dd>{{ php_version }} ({{ sapi }})</dd>
            <dt>Executed by</dt><dd>esw-engine, supervised by ember</dd>
        </dl>
    </div>
{% endblock %}
