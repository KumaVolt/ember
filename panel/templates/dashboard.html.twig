{% extends 'base.html.twig' %}
{% block title %}{{ brand.name }} — Dashboard{% endblock %}

{% block body %}
    <header class="page">
        <div>
            <h1>Dashboard</h1>
            <p>{{ brand.tagline }}</p>
        </div>
        <a class="btn" href="{{ path('domains') }}">Add a domain</a>
    </header>

    <div class="tiles">
        <div class="tile">
            <div class="label">Domains</div>
            <div class="value">{{ summary.domains }}</div>
            <div class="sub">hosted on this server</div>
        </div>
        <div class="tile">
            <div class="label">Customers</div>
            <div class="value">{{ summary.customers }}</div>
            <div class="sub">each a system account</div>
        </div>
        <div class="tile">
            <div class="label">Service</div>
            <div class="value" style="font-size:1.1rem">
                {% if status %}<span class="badge ok">{{ status.status }}</span>
                {% else %}<span class="badge warn">unknown</span>{% endif %}
            </div>
            <div class="sub">
                {% if status %}up {{ (status.uptime_seconds / 60)|round(0, 'floor') }} min{% endif %}
            </div>
        </div>
        <div class="tile">
            <div class="label">Mode</div>
            <div class="value" style="font-size:1.1rem">
                {% if status %}
                    <span class="badge {{ status.manages_this_machine ? 'warn' : 'muted' }}">
                        {{ status.mode }}
                    </span>
                {% endif %}
            </div>
            <div class="sub">
                {{ status and status.manages_this_machine
                    ? 'manages this machine' : 'manages nothing outside its own directory' }}
            </div>
        </div>
    </div>

    <div class="card">
        <h2>Recent domains</h2>
        {% if domains is empty %}
            <div class="empty">
                <p>No domains yet.</p>
                <a class="btn" href="{{ path('domains') }}">Add your first domain</a>
            </div>
        {% else %}
            <table>
                <tr><th>Domain</th><th>Customer</th><th>Document root</th><th>Server</th></tr>
                {% for domain in domains|slice(0, 5) %}
                    <tr>
                        <td><strong>{{ domain.name }}</strong></td>
                        <td>{{ domain.customer_username }}</td>
                        <td class="mono">{{ domain.docroot }}</td>
                        <td><span class="badge muted">{{ domain.webserver }}</span></td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}
    </div>
{% endblock %}
