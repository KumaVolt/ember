{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}
{% block title %}{{ brand.name }} — Customers{% endblock %}

{% block body %}
    <header class="page">
        <div>
            <h1>Customers</h1>
            <p>Every customer is a system account. Their files and processes run as that user.</p>
        </div>
        <a class="btn" href="{{ path('customer_new') }}">{{ ui.icon('plus', 15) }} Add customer</a>
    </header>

    <div class="card">
        {% if customers is empty %}
            <div class="empty">
                <p>No customers yet.</p>
                <a class="btn" href="{{ path('customer_new') }}">{{ ui.icon('plus', 15) }} Add your first customer</a>
            </div>
        {% else %}
            <table>
                <tr><th>Customer</th><th>System account</th><th>Email</th><th>Domains</th><th></th></tr>
                {% for customer in customers %}
                    <tr data-filter="{{ (customer.username ~ ' ' ~ (customer.display_name ?: '') ~ ' ' ~ (customer.email ?: ''))|lower }}">
                        <td><strong>{{ customer.display_name ?: customer.username }}</strong></td>
                        <td class="mono">{{ customer.username }}</td>
                        <td>{{ customer.email ?: '—' }}</td>
                        <td>{{ customer.domain_count }}</td>
                        <td style="text-align:right">
                            <form method="post" action="{{ path('customer_delete', {id: customer.id}) }}"
                                  onsubmit="return confirm('Remove {{ customer.username }}?')">
                                <button class="btn danger sm" type="submit">{{ ui.icon('trash', 13) }} Remove</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}
    </div>
{% endblock %}
